# GitHub Pages client-testing build. Pass these to `npm run build` (production mode).
# Do not use `vite build --mode staging`: that mode rejects this host.
# No secrets belong in VITE_* variables.

VITE_PUBLIC_API_BASE_URL=https://dakh-backend.onrender.com/api/public/v1
VITE_PUBLIC_HOTEL_SLUG=dakh
VITE_ACCOMMODATION_HOTEL_MAP=merged
VITE_BOOKING_ENABLED=true
