{
  "name": "dakh-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local-booking": "node scripts/dev-local-booking.mjs",
    "build": "tsc -b && vite build && tsx scripts/copy-pages-fallback.ts",
    "build:staging": "tsc -b && vite build --mode staging && tsx scripts/copy-pages-fallback.ts",
    "lint": "oxlint",
    "test": "tsx --tsconfig tsconfig.tests.json --test src/lib/publicBooking/*.test.ts src/lib/catalog/*.test.ts src/lib/siteBase.test.ts src/lib/ukrainian.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "libphonenumber-js": "^1.12.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
