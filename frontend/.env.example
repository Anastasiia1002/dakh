# Public booking API (no secrets). Local `npm run dev` default:
VITE_PUBLIC_API_BASE_URL=http://localhost:3000/api/public/v1
# `npm run build` refuses a missing URL, a non-https URL, and any loopback host.
# GitHub Pages should set VITE_PUBLIC_API_BASE_URL=https://<render-host>/api/public/v1
# on the build step. Do not put secrets in VITE_* variables.
VITE_PUBLIC_HOTEL_SLUG=dakh
# Quotes, booking intents, OTP and confirmation stay off unless this is exactly true.
# A missing or any other value keeps the site read-only. This is a frontend safeguard,
# not backend authorization, and it does not stop a direct API call.
VITE_BOOKING_ENABLED=false
# Catalog page slug = room-type slug. Identity is the default.
# Local E2E inventory uses a prefix, so set an explicit map. Do not infer it from names.
# VITE_PUBLIC_ROOM_SLUG_MAP=bukovyna=e2e-bukovyna,goryshche=e2e-goryshche,plats=e2e-plats
